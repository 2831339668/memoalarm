<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="#111111" android:padding="24dp">
    <TextView android:id="@+id/alarmTime" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#FFFFFF"
        android:textSize="56sp" android:textStyle="bold"/>
    <TextView android:id="@+id/alarmLabel" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#FFEB3B"
        android:textSize="28sp" android:layout_marginTop="16dp"/>
    <Button android:id="@+id/dismissBtn" android:layout_width="match_parent"
        android:layout_height="64dp" android:layout_marginTop="48dp"
        android:text="我知道了，关闭" android:textSize="20sp"/>
</LinearLayout>
